# انسخ هذا الملف إلى .env واملأ القيم محليًا. لا ترفع .env إلى Git.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
BX_OWNER_DISCORD_ID=
BOT_API_SECRET=
PORT=8080

# اختيارية: معرّفات /setup. ALLOWED_GUILD_ID إن استُخدم يطابق DISCORD_GUILD_ID.
# ALLOWED_GUILD_ID=
# DISCORD_CHANNEL_CATEGORY=
# DISCORD_CHANNEL_UPDATES=
# DISCORD_CHANNEL_SUPPORT=
# DISCORD_CHANNEL_CREATORS=
# DISCORD_CHANNEL_OFFERS=
# DISCORD_ROLE_VIP_MONARCH=
# DISCORD_ROLE_VIP_BASIC=
# DISCORD_ROLE_CREATOR=
# DISCORD_WEBHOOK_UPDATES=
# DISCORD_WEBHOOK_SUPPORT=
# DISCORD_WEBHOOK_CREATORS=
# DISCORD_WEBHOOK_OFFERS=

# اختيارية: تطبيق البوت في Heroku → Settings → Config Vars (وليس موقع AI Studio).
# Turso Cloud: اضبط المتغيرين معًا لو هتستخدم Turso. لا تضع رابط Turso في DATABASE_URL.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# البديل هو Postgres، عندما لا تضبط أيّ متغير من متغيرات Turso.
# DATABASE_URL=  # Heroku Postgres يضبطها تلقائيًا عند الإرفاق. لا تشاركها.
# BX_DATABASE_CA=  # محتوى PEM للـ CA الرسمي لمزوّد Postgres، عند الحاجة (انظر الدليل).
