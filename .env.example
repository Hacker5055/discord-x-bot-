# انسخ هذا الملف إلى .env واملأ القيم محليًا. لا ترفع .env إلى Git.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
BX_OWNER_DISCORD_ID=
# سر مستقل مولّد من 32 بايت عشوائية على الأقل: hex بطول 64 حرفًا أو base64url بطول 43–128 حرفًا.
# حدّثه في البوت وخادم الموقع معًا قبل نشر الترقية لو القيمة القديمة قصيرة. لا تستخدم توكن Discord.
BOT_API_SECRET=
PORT=8080

# اختيارية: معرّفات /setup scope:integrations. ALLOWED_GUILD_ID إن استُخدم يطابق DISCORD_GUILD_ID.
# ALLOWED_GUILD_ID=
# DISCORD_CHANNEL_CATEGORY=
# DISCORD_CHANNEL_UPDATES=
# DISCORD_CHANNEL_SUPPORT=
# DISCORD_CHANNEL_CREATORS=
# DISCORD_CHANNEL_OFFERS=
# DISCORD_ROLE_VIP_MONARCH=
# DISCORD_ROLE_VIP_BASIC=
# DISCORD_ROLE_CREATOR=
# DISCORD_WEBHOOK_UPDATES=
# DISCORD_WEBHOOK_SUPPORT=
# DISCORD_WEBHOOK_CREATORS=
# DISCORD_WEBHOOK_OFFERS=

# اختيارية: تطبيق البوت في Heroku → Settings → Config Vars (وليس موقع AI Studio).
# Turso Cloud: اضبط المتغيرين معًا لو هتستخدم Turso. لا تضع رابط Turso في DATABASE_URL.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# البديل هو Postgres، عندما لا تضبط أيّ متغير من متغيرات Turso.
# DATABASE_URL=  # Heroku Postgres يضبطها تلقائيًا عند الإرفاق. لا تشاركها.
# BX_DATABASE_CA=  # محتوى PEM للـ CA الرسمي لمزوّد Postgres، عند الحاجة (انظر الدليل).

# اختيارية لأدوات الإدارة (تحتاج تخزينًا و /admin enable). الإعداد الافتراضي متوقف.
# BX_ADMIN_VOICE=1  # GuildVoiceStates للرومات الصوتية المؤقتة.
# BX_ADMIN_AUTOMOD=1  # AutoModerationExecution لعدّ أحداث Discord AutoMod.

# اختيارية للترحيب: فعّل Server Members Intent في Discord Developer Portal أولًا، ثم /welcome enable بعد المعاينة.
# BX_WELCOME=1

# اختيارية لجسر الموقع: قيمة عشوائية مستقلة (32–128 حرف base64url)، مشتركة بين خادم البوت وخادم الموقع فقط.
# لا تستخدم BOT_API_SECRET أو أي VITE_/NEXT_PUBLIC_؛ /admin bridge enabled:true بعد اختبار الطرفين.
# BX_SITE_BRIDGE_SECRET=
